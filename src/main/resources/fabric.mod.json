{
    "schemaVersion": 1,
    "id": "astraclient",
    "version": "${version}",
    "name": "Astra Client",
    "description": "A modern modular Minecraft Fabric client.",
    "authors": [
        "nelusion"
    ],
    "contact": {
        "sources": "https://github.com/"
    },
    "license": "CC0-1.0",
    "icon": "assets/astraclient/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.nelusion.astraclient.AstraClient"
        ],
        "client": [
            "com.nelusion.astraclient.AstraClientInitializer"
        ]
    },
    "mixins": [
        "astraclient.mixins.json",
        {
            "config": "astraclient.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
